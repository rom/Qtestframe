{
  "name": "qtestframe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "a11y": "node scripts/a11y-check.mjs",
    "guide:screenshots": "node scripts/guide-screenshots.mjs",
    "guide:export": "node scripts/guide-export.mjs"
  },
  "dependencies": {
    "@primevue/themes": "4.5.4",
    "chart.js": "4.4.9",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "pinia": "3.0.3",
    "primeicons": "7.0.0",
    "primevue": "4.5.4",
    "vue": "3.5.45",
    "vue-i18n": "11.4.16",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/tsconfig": "0.7.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.1",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
