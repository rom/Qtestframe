#!/usr/sbin/nft -f
# Example host firewall for a Qtestframe server (nftables).
#
#   install -m 0644 deploy/nftables/qtestframe.nft /etc/nftables.d/qtestframe.nft
#   nft -c -f /etc/nftables.d/qtestframe.nft      # syntax check
#   nft -f /etc/nftables.d/qtestframe.nft
#
# Adjust the sets below. Policy: drop everything inbound except SSH from the
# admin network, HTTPS to Qtestframe and ICMP; outbound restricted to what
# Qtestframe needs (DNS, NTP, PostgreSQL, IdP HTTPS, syslog-TLS, package
# updates). Outbound filtering is optional — remove the output chain's
# "policy drop" if it is too strict for your environment.

# Replace only our own table, leave other rulesets alone.
table inet qtestframe
delete table inet qtestframe

table inet qtestframe {
	set admin_v4 {
		type ipv4_addr; flags interval
		elements = { 10.0.0.0/8, 192.168.0.0/16 }
	}
	set admin_v6 {
		type ipv6_addr; flags interval
		elements = { fd00::/8 }
	}
	# Ports clients may connect to (8443 default listener, 443 if bound or redirected).
	set qtf_ports {
		type inet_service
		elements = { 443, 8443 }
	}
	# Upstream services Qtestframe connects to.
	set out_tcp_ports {
		type inet_service
		elements = { 53, 443, 5432, 6514, 8443 }
	}
	set out_udp_ports {
		type inet_service
		elements = { 53, 123, 514 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		# ICMP needed for PMTU discovery and IPv6 neighbour discovery.
		meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
		meta l4proto ipv6-icmp accept
		# SSH only from admin networks, rate limited.
		tcp dport 22 ip saddr @admin_v4 ct state new limit rate 10/minute accept
		tcp dport 22 ip6 saddr @admin_v6 ct state new limit rate 10/minute accept
		# Qtestframe HTTPS. Per-source connection limit as a cheap DoS brake
		# (the server additionally rate-limits logins).
		tcp dport @qtf_ports ct state new meter qtf_connlimit { ip saddr ct count over 200 } counter drop
		tcp dport @qtf_ports ct state new meter qtf_connlimit6 { ip6 saddr ct count over 200 } counter drop
		tcp dport @qtf_ports ct state new accept
		limit rate 5/minute log prefix "nft-qtf-drop: " level info
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		oifname "lo" accept
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport @out_tcp_ports accept
		udp dport @out_udp_ports accept
		# Package updates over HTTP (apt/dnf mirrors).
		tcp dport 80 accept
		limit rate 5/minute log prefix "nft-qtf-out-drop: " level info
	}

	# Optional: expose the service on 443 while it listens unprivileged on
	# 8443 (alternative to CAP_NET_BIND_SERVICE). Uncomment to enable.
	#chain prerouting {
	#	type nat hook prerouting priority dstnat; policy accept;
	#	tcp dport 443 redirect to :8443
	#}
}
