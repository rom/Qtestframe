      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(qtf_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval]))))",
          "legendFormat": "{{route}}"
